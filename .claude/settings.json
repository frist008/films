{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent|Bash|PowerShell|CronCreate|CronDelete",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-watchdog.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/watchdog-tick.sh\"",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gtv-tick.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/plex-guard.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*|mcp__Claude_Browser__.*|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gtv-guard.sh\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/playlist-guard.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/survey-guard.sh\"",
            "timeout": 15
          },
          {
            "type": "prompt",
            "timeout": 60,
            "prompt": "Аудит понятности вопроса владельцу проекта films (владелец, 2026-10-25). Владелец сам качает фильмы, ведёт эту таблицу и понимает обычные слова и свои термины: таблица, лист таблицы, строка, сортировка, баллы, франшиза, сезон, плейлист, трейлер, раздача, rutor, rutracker, торрент, qBittorrent, Plex, Jellyfin, Google TV, GitHub, 4K, HDR, Dolby Vision, BDRemux, WEB-DL, дубляж, озвучка, диски, Windows, Telegram, Viber, Zoom, IMDb, TMDB, Rotten Tomatoes. Вопрос(ы): $ARGUMENTS\nПо умолчанию РАЗРЕШИ (allow). Откажи (deny) только при явной проблеме: (1) слово «база» без уточнения «на компьютере» или «на GitHub»; (2) имя файла, таблицы базы данных, поля или команды программиста без пояснения; (3) у варианта ответа совсем не сказано, что будет сделано; (4) в одном вопросе два разных вопроса. Мелкие стилистические придирки — не повод для отказа. Ответ: решение и одна фраза."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-memory.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan_guard.py\" prompt",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan_guard.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}